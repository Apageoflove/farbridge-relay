# Copy to deploy/secrets.env, chmod 600, and replace every example value.
APP_ENV=production
DATABASE_URL=sqlite:////data/phone-mirror/data/phone-mirror.db
ENCRYPTION_KEY=GENERATE_32_BYTE_URLSAFE_BASE64
SESSION_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=GENERATE_ARGON2ID_HASH
DEVICE_SECRETS_JSON={"android-device-01":"GENERATE_AT_LEAST_32_RANDOM_CHARACTERS"}
SECURE_COOKIE=true
BARK_ENABLED=false
BARK_BASE_URL=https://api.day.app
BARK_KEY=OPTIONAL_PRIVATE_KEY
BARK_PRIVACY_MODE=true
VAPID_PUBLIC_KEY=OPTIONAL_PUBLIC_KEY
VAPID_PRIVATE_KEY=OPTIONAL_PRIVATE_KEY
